# Authorize.Net sandbox. Create the account yourself at
# https://developer.authorize.net/hello_world/sandbox.html
# and paste the credentials here. This file is the example; copy it to .env,
# which is gitignored and never leaves your machine.
ANET_API_LOGIN_ID=
ANET_TRANSACTION_KEY=
ANET_SIGNATURE_KEY=
ANET_ENV=sandbox

# Any Postgres. A free Supabase project works, and it is what the job spec uses.
#
# Use Supabase's SESSION POOLER string, not the direct connection. The direct
# host (db.<ref>.supabase.co) resolves over IPv6 only, so on most networks it
# fails with getaddrinfo ENOTFOUND. Dashboard -> Connect -> Session pooler.
#
# Session mode (port 5432), not transaction mode (6543): the webhook path uses
# BEGIN/COMMIT with SELECT ... FOR UPDATE, which transaction pooling does not
# reliably support.
#
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

PORT=3100

# Promotional window during which qualifying members get the VIP multiplier.
VIP_EARLY_BIRD_UNTIL=2027-06-30
VIP_MULTIPLIER=2
